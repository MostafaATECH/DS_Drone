{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "board",
      "type": "promptString",
      "description": "Zephyr board target",
      "default": "nucleo_wl55jc/stm32wl55xx"
    }
  ],
  "tasks": [
    {
      "label": "West: Build",
      "type": "process",
      "command": "${env:USERPROFILE}/zephyrproject/.venv/Scripts/west.exe",
      "args": [
        "build",
        "--board",
        "${input:board}",
        "-d",
        "build/step02",
        ".",
        "--",
        "-DCONF_FILE=confs/prj_nucleo_wl55jc.conf",
        "-DDTC_OVERLAY_FILE=boards/nucleo_wl55jc.overlay"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "ZEPHYR_BASE": "${env:USERPROFILE}/zephyrproject/zephyr",
          "ZEPHYR_TOOLCHAIN_VARIANT": "zephyr",
          "ZEPHYR_SDK_INSTALL_DIR": "${env:USERPROFILE}/Desktop/University programing/tools/zephyr-sdk-1.0.1",
          "PYTHONDONTWRITEBYTECODE": "1"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "West: Pristine Build",
      "type": "process",
      "command": "${env:USERPROFILE}/zephyrproject/.venv/Scripts/west.exe",
      "args": [
        "build",
        "--pristine=always",
        "--board",
        "${input:board}",
        "-d",
        "build/step02",
        ".",
        "--",
        "-DCONF_FILE=confs/prj_nucleo_wl55jc.conf",
        "-DDTC_OVERLAY_FILE=boards/nucleo_wl55jc.overlay"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "ZEPHYR_BASE": "${env:USERPROFILE}/zephyrproject/zephyr",
          "ZEPHYR_TOOLCHAIN_VARIANT": "zephyr",
          "ZEPHYR_SDK_INSTALL_DIR": "${env:USERPROFILE}/Desktop/University programing/tools/zephyr-sdk-1.0.1",
          "PYTHONDONTWRITEBYTECODE": "1"
        }
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "West: Flash",
      "type": "process",
      "command": "${env:USERPROFILE}/zephyrproject/.venv/Scripts/west.exe",
      "args": [
        "flash",
        "-d",
        "build/step02",
        "--runner",
        "openocd"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "ZEPHYR_BASE": "${env:USERPROFILE}/zephyrproject/zephyr",
          "ZEPHYR_TOOLCHAIN_VARIANT": "zephyr",
          "ZEPHYR_SDK_INSTALL_DIR": "${env:USERPROFILE}/Desktop/University programing/tools/zephyr-sdk-1.0.1",
          "PYTHONDONTWRITEBYTECODE": "1"
        }
      },
      "problemMatcher": []
    }
  ]
}
